{
    "name": "php-shark-tank/anonymizer-bundle",
    "description": "Symfony bundle to integrate anonymizer component into a symfony application",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2 <8.6",
        "php-shark-tank/anonymizer": "^1.1",
        "symfony/config": "^6.4 || ^7.4 || ^8.1",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.1",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.1",
        "symfony/yaml": "^6.4 || ^7.4 || ^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "symfony/expression-language": "^6.4 || ^7.4 || ^8.1",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "PHPSharkTank\\AnonymizerBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPSharkTank\\AnonymizerBundle\\Tests\\": "Tests"
        }
    },
    "authors": [
        {
            "name": "Eric Hertwig",
            "email": "eric@ehdev.de"
        },
        {
            "name": "Markus Bachmann",
            "email": "markus.bachmann@bachi.biz"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}
